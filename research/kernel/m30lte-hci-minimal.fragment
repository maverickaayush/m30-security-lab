# Source-backed choices observed in the running M305FDDS8CVB2 kernel.
# Only Linux Bluetooth core and the SCSC bridge are intended feature changes.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_HS=n
CONFIG_BT_DEBUGFS=n
CONFIG_SCSC_BT=y
CONFIG_SCSC_BT_BLUEZ=y

CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=n
CONFIG_DM_VERITY_AVB=n
CONFIG_DM_ANDROID_VERITY_AT_MOST_ONCE_DEFAULT_ENABLED=y
CONFIG_USB_OTG=n
CONFIG_SCSC_DEBUG=n
CONFIG_SCSC_DEBUG_COMPATIBILITY=n
CONFIG_SCSC_STATIC_RING=n

CONFIG_DEFEX_KERNEL_ONLY=y
CONFIG_EXYNOS_KERNEL_PROTECTION=y
CONFIG_KNOX_KAP=y
CONFIG_TIMA=y
CONFIG_TIMA_LOG=y
CONFIG_TZ_ICCC=y
CONFIG_SOFT_WATCHDOG=y
CONFIG_EXYNOS_FMP_FIPS=n
CONFIG_EXYNOS_HDCP2=n
CONFIG_ION_TEST=n
CONFIG_NTFS_FS=n
CONFIG_QCOM_FALKOR_ERRATUM_1003=n
